PORT=3001
JWT_SECRET=change-me

# Local dev (Postgres running on your machine or via docker compose):
DATABASE_URL=postgresql://mosk:mosk@localhost:5432/mosk?schema=public

# Example with your own credentials:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# During local dev you can allow any origin:
CORS_ORIGIN=http://localhost:5173
